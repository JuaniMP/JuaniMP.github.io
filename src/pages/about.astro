---
import Layout from '@/layouts/BlogPost.astro';

const tags = ['Estudiante', 'Ingeniería', 'SQL'];
---

<Layout
	tags={tags}
	icon="beach" 
	title="Presentación"
	description="Conoce más sobre mi "
	pubDate={new Date()}
    heroImage="/src/assets/gatitos.webp"
    showBackButton={false}
    showHomeButton={true}
>
    <section class="mb-10">
        <h2 class="text-2xl font-bold mb-4">Video de Presentación</h2>
        <div class="aspect-video w-full border-2 border-black rounded-xl overflow-hidden shadow-card">
            <iframe 
                width="100%" 
                height="100%" 
                src="https://www.youtube.com/embed/WE1y2TnYfxY?start=1" 
                title="Presentación Juanita" 
                frameborder="0" 
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                allowfullscreen>
            </iframe>
        </div>
    </section>

    <section>
        <h2 class="text-2xl font-bold mb-4">¿Quién soy?</h2>
        <p>
            Hola, soy <strong>Juanita Mejía Pineda</strong>, estudiante de Ingeniería de Sistemas.
            Me apasiona el mundo de los datos y el desarrollo de software.
        </p>
        <p>
            En este portafolio encontrarás mis trabajos académicos, especialmente enfocados en
            bases de datos (SQL), donde demuestro mi capacidad para resolver problemas complejos de negocio.
        </p>
    </section>
</Layout>