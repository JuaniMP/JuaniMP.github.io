---
import { Icon } from "astro-icon/components";
import { Picture } from "astro:assets";
// Asegúrate de tener una foto tuya llamada 'perfil.webp' en src/assets/ o usa la que ya tienes
import img from "/src/assets/gatitos.webp"; 
---

<section class="py-20 flex md:flex-row flex-col px-4 md:px-0 gap-10 md:gap-0 self-center max-w-5xl mx-auto items-center">
  <div class="flex flex-col gap-6 justify-start items-start md:w-1/2">
    <h1 class="text-pblack">Hola, soy Juanita Mejía</h1>
    <p class="text-6xl font-bold">Portafolio & Repositorio.</p>
    <p>
        Estudiante de Ingeniería de Sistemas.
        En este espacio presento una recopilación de ejercicios desarrollados en la clase de 
        <strong>Bases De Datos 2</strong> y proyectos independientes.
    </p>
    <div class="flex gap-4">
      <a
        href="/blog"
        class="bg-pgreen px-5 py-3 border-1 border-black rounded-lg shadow-card hover:shadow-hover transition font-bold"
      >
        Ver Consultas SQL
      </a>
      <a
        href="/about"
        class="bg-ppink px-5 py-3 border-1 border-black rounded-lg shadow-card hover:shadow-hover transition font-bold"
      >
        Sobre Mí
      </a>
    </div>
  </div>
  
  <div class="md:w-1/2 flex items-center justify-end p-10">
     <div class="border-3 border-black rounded-2xl overflow-hidden shadow-card transform hover:scale-105 transition">
        <Picture
            src={img}
            format="webp"
            widths={[300, 600]}
            alt="Juanita Mejía"
            class="object-cover h-full w-full"
          />
     </div>
  </div>
</section>