---
import { Icon } from "astro-icon/components";
import { Picture } from "astro:assets";
// Asegúrate de tener una foto tuya llamada 'perfil.webp' en src/assets/ o usa la que ya tienes
import img1 from "/src/assets/Naruto.webp"; 
import img2 from "/src/assets/Yo.webp";
import img3 from "/src/assets/Yo2.webp";

const images = [img1, img2, img3];
---

<section class="py-20 flex md:flex-row flex-col px-4 md:px-0 gap-10 md:gap-0 self-center max-w-5xl mx-auto items-center">
  <div class="flex flex-col gap-6 justify-start items-start md:w-1/2">
    <h1 class="text-pblack">Hola, soy Juanita Mejía</h1>
    <p class="text-6xl font-bold">Portafolio & Repositorio.</p>
    <p>
        Estudiante de Ingeniería de Sistemas.
        En este espacio presento una recopilación de ejercicios desarrollados en la clase de 
        <strong>Bases De Datos 2</strong> y proyectos independientes.
    </p>
    <div class="flex gap-4">
      <a
        href="/blog"
        class="bg-pgreen px-5 py-3 border-1 border-black rounded-lg shadow-card hover:shadow-hover transition font-bold"
      >
        Ver Consultas 
      </a>
      <a
        href="/about"
        class="bg-ppink px-5 py-3 border-1 border-black rounded-lg shadow-card hover:shadow-hover transition font-bold"
      >
        Sobre Mí
      </a>
    </div>
  </div>
  
  <div class="md:w-1/2 flex items-center justify-end p-10">
     <div 
       id="hero-image-container"
       class="border-3 border-black rounded-2xl overflow-hidden shadow-card transform hover:scale-105 transition cursor-pointer relative"
       style="height: 400px; width: 400px;"
     >
        {images.map((img, index) => (
          <div 
            class={`hero-image ${index === 0 ? 'active' : ''}`}
            data-index={index}
          >
            <Picture
              src={img}
              format="webp"
              widths={[300, 600]}
              alt="Juanita Mejía"
              class="object-cover h-full w-full"
            />
          </div>
        ))}
     </div>
  </div>
</section>

<style>
  .hero-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .hero-image.active {
    opacity: 1;
    pointer-events: auto;
  }

  .hero-image.swipe-up-out {
    animation: swipeUpOut 0.6s ease-in-out forwards;
  }

  .hero-image.swipe-up-in {
    animation: swipeUpIn 0.6s ease-in-out forwards;
  }

  @keyframes swipeUpOut {
    0% {
      transform: translateY(0);
      opacity: 1;
    }
    100% {
      transform: translateY(-100%);
      opacity: 0;
    }
  }

  @keyframes swipeUpIn {
    0% {
      transform: translateY(100%);
      opacity: 0;
    }
    100% {
      transform: translateY(0);
      opacity: 1;
    }
  }
</style>

<script>
  let currentIndex = 0;
  const totalImages = 3;

  function setupImageSwitcher() {
    const container = document.getElementById('hero-image-container');
    if (!container) return;

    container.addEventListener('click', () => {
      const currentImage = container.querySelector('.hero-image.active');
      if (!currentImage) return;

      // Calcular siguiente índice
      const nextIndex = (currentIndex + 1) % totalImages;
      const nextImage = container.querySelector(`[data-index="${nextIndex}"]`);
      if (!nextImage) return;

      // Animación de salida
      currentImage.classList.add('swipe-up-out');
      currentImage.classList.remove('active');

      // Animación de entrada después de un delay
      setTimeout(() => {
        nextImage.classList.add('swipe-up-in', 'active');
        
        // Limpiar clases de animación
        setTimeout(() => {
          currentImage.classList.remove('swipe-up-out');
          nextImage.classList.remove('swipe-up-in');
        }, 600);
      }, 100);

      currentIndex = nextIndex;
    });
  }

  // Ejecutar al cargar la página
  setupImageSwitcher();

  // Volver a ejecutar después de navegación con View Transitions
  document.addEventListener('astro:after-swap', setupImageSwitcher);
</script>